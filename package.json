{
  "name": "dsh-drop-by",
  "version": "1.4.1",
  "description": "到点了，她自己来找你说话：按固定/随机间隔往指定会话送一条「她自己的念头」，由 DSH 自己开一轮生成真正的聊天内容；可选把这一轮她真说的话一条一条发到 QQ 私聊。设置页在 DSH 设置的「鱼的QQ敲门」里。",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "SHARING.md",
    "CHANGELOG.md",
    "LICENSE",
    "install.mjs",
    "install.ps1",
    "uninstall.ps1",
    "tests"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "proactive",
    "initiative",
    "onebot",
    "qq"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akisawadayo/dsh-drop-by.git"
  },
  "homepage": "https://github.com/akisawadayo/dsh-drop-by#readme",
  "bugs": {
    "url": "https://github.com/akisawadayo/dsh-drop-by/issues"
  }
}
